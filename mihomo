mixed-port: 7890
ipv6: true
allow-lan: true
unified-delay: true
tcp-concurrent: true

dns:
  enable: true
  listen: 0.0.0.0:53
  ipv6: true
  respect-rules: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.0/15
  nameserver:
    - https://223.5.5.5/dns-query
    - 223.5.5.5
  fallback:
    - https://cn-05.api.vlo.cc/tls-cx
    - 8.8.8.8
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
  nameserver-policy:
    "geosite:cn":
      - https://223.5.5.5/dns-query
      - 223.5.5.5
    "geosite:geolocation-!cn":
      - https://cn-05.api.vlo.cc/tls-cx
      - 8.8.8.8

proxies: []

proxy-groups:
  - name: " 节点选择"
    type: select
    proxies:
      - "自动选择"

  - name: "BiliBili"
    type: select
    proxies:
      - "全球直连"
      - " 节点选择"

  - name: "Bahamut"
    type: select
    proxies:
      - " 节点选择"

  - name: "Telegram"
    type: select
    proxies:
      - " 节点选择"
      - "自动选择"

  - name: "OpenAI"
    type: select
    proxies:
      - " 节点选择"

  - name: "YouTube"
    type: select
    proxies:
      - " 节点选择"
      - "自动选择"

  - name: "Microsoft"
    type: select
    proxies:
      - " 节点选择"
      - "全球直连"

  - name: "Steam"
    type: select
    proxies:
      - " 节点选择"
      - "自动选择"

  - name: "自动选择"
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 180
    tolerance: 150
    proxies:
      - DIRECT

  - name: "全球直连"
    type: select
    proxies:
      - DIRECT
      - REJECT

  - name: "全球拦截"
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: "漏网之鱼"
    type: select
    proxies:
      - " 节点选择"
      - "全球直连"

  - name: "GLOBAL"
    type: select
    proxies:
      - " 节点选择"
      - "自动选择"
      - "全球直连"
      - "全球拦截"
      - "漏网之鱼"

