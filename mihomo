mixed-port: 7890
ipv6: true
allow-lan: true
unified-delay: true
tcp-concurrent: true

dns:
  enable: true
  listen: 0.0.0.0:53
  ipv6: true
  respect-rules: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.0/15
  nameserver:
    - https://223.5.5.5/dns-query
    - 223.5.5.5
  fallback:
    - https://cn-05.api.vlo.cc/tls-cx
    - 8.8.8.8
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
  nameserver-policy:
    "geosite:cn":
      - https://223.5.5.5/dns-query
      - 223.5.5.5
    "geosite:geolocation-!cn":
      - https://cn-05.api.vlo.cc/tls-cx
      - 8.8.8.8

# 锚点区
Proxy_first: &Proxy_first
  type: select
  proxies: [节点选择, 香港节点, 台湾节点, 日本节点, 韩国节点, 新加坡节点, 美国节点, 全部节点, 全球直连]

Direct_first: &Direct_first
  type: select
  proxies: [全球直连, 节点选择, 香港节点, 台湾节点, 日本节点, 韩国节点, 新加坡节点, 美国节点, 全部节点]

Include_all: &Include_all
  type: select
  proxies: [节点选择, 香港节点, 台湾节点, 日本节点, 韩国节点, 新加坡节点, 美国节点, 全部节点, 全球直连]
  include-all: true
  exclude-filter: "(?i)(🟢 直连)"

Urltest_Base: &Urltest_Base
  type: url-test
  use:
    - Airport_01
    - Airport_02
    - Airport_03
  tolerance: 20
  interval: 300
  max-failed-times: 1
  hidden: true

PProviders: &PProviders
  type: http
  interval: 86400
  health-check:
    enable: true
    url: 'https://www.gstatic.com/generate_204'
    interval: 300
  filter: '^(?!.*(拒绝|直连|群|邀请|返利|循环|官网|客服|网站|网址|获取|订阅|流量|到期|机场|下次|版本|官址|备用|过期|已用|联系|邮箱|工单|贩卖|通知|倒卖|防止|国内|地址|频道|无法|说明|提示|特别|访问|支持|教程|关注|更新|作者|加入|USE|USED|TOTAL|EXPIRE|EMAIL|Panel|Channel|Author|traffic))'

##############################################
# 机场订阅，Airport_01/02/03名称不能重复,但可修改为自己喜欢的
# 订阅链接1/2/3是用来写订阅链接的，填入即可
# 机场名称1/2/3是用来给节点添加备注的，不用记得整行删除
proxy-providers:
  Airport_01:
    <<: *PProviders
    url: "订阅链接1"
    override:
      additional-prefix: '[机场名称1]'
      skip-cert-verify: true
      udp: true
  Airport_02:
    <<: *PProviders
    url: "订阅链接2"
    override:
      additional-prefix: '[机场名称2]'
      skip-cert-verify: true
      udp: true
  Airport_03:
    <<: *PProviders
    url: "订阅链接3"
    override:
      additional-prefix: '[机场名称3]'
      skip-cert-verify: true
      udp: true

proxies: []

proxy-groups:
  - name: "节点选择"
    <<: *Proxy_first
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/select.png"

  - name: "全部节点"
    type: select
    use:
      - Airport_01
      - Airport_02
      - Airport_03
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/global.png"

  - name: "香港节点"
    <<: *Urltest_Base
    filter: "(?i)港|HK|Hong Kong"
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/Hongkong.png"

  - name: "台湾节点"
    <<: *Urltest_Base
    filter: "(?i)台|TW|Taiwan"
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/Taiwan.png"

  - name: "日本节点"
    <<: *Urltest_Base
    filter: "(?i)日|JP|Japan"
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/Japan.png"

  - name: "韩国节点"
    <<: *Urltest_Base
    filter: "(?i)韩|KR|South Korea"
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/Korea.png"

  - name: "新加坡节点"
    <<: *Urltest_Base
    filter: "(?i)新|SG|Singapore"
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/Singapore.png"

  - name: "美国节点"
    <<: *Urltest_Base
    filter: "(?i)美|US|United States"
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/United_States.png"

  - name: "自动选择"
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 180
    tolerance: 150
    use:
      - Airport_01
      - Airport_02
      - Airport_03
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/auto.png"

  - name: "BiliBili"
    <<: *Direct_first
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/bilibili.png"

  - name: "Bahamut"
    type: select
    proxies: [台湾节点, 节点选择, 香港节点]
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/bahamut.png"

  - name: "Telegram"
    <<: *Proxy_first
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/telegram.png"

  - name: "OpenAI"
    type: select
    proxies: [美国节点, 日本节点, 新加坡节点, 节点选择]
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/openai.png"

  - name: "YouTube"
    <<: *Proxy_first
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/youtube.png"

  - name: "Microsoft"
    <<: *Direct_first
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/microsoft.png"

  - name: "Steam"
    <<: *Proxy_first
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/steam.png"

  - name: "全球直连"
    type: select
    proxies: [DIRECT, REJECT]
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/direct.png"

  - name: "全球拦截"
    type: select
    proxies: [REJECT, DIRECT]
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/reject.png"

  - name: "漏网之鱼"
    <<: *Proxy_first
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/fish.png"

  - name: "GLOBAL"
    <<: *Proxy_first
    icon: "https://raw.githubusercontent.com/Lanlan13-14/Rules/main/icon/global.png"

